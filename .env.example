# FabOptic Eyewear Pakistan - Environment Configuration Template
# Copy this file to .env and fill in your secrets

# Server Port
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# JWT / Session Secret Key (generate a strong random string for production)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_BYTE_HEX_STRING

# Owner/Admin panel password (replaces default "admin" — set a strong one!)
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Store Contact Info
STORE_NAME="FabOptic Eyewear Pakistan"
CONTACT_PHONE="03241383370"
WHATSAPP_NUMBER="923241383370"

# Set to 1 when behind a reverse proxy (Nginx, Caddy, Render, Railway)
# TRUST_PROXY=1

# CORS (leave empty to disable, or set to your frontend domain)
# CORS_ORIGIN=https://faboptic.pk

# MongoDB Atlas Cloud Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/faboptic?retryWrites=true&w=majority

# ==========================================
# ADMIN & CUSTOMER ORDER NOTIFICATIONS
# ==========================================
# To receive automatic email alerts when an order is placed:
# (For Gmail: Use an App Password from https://myaccount.google.com/apppasswords)
ADMIN_EMAIL=rdanial795@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rdanial795@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional: Instant Mobile Push Webhook (Discord / Slack)
# ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

